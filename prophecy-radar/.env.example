# Database (leave unset to run the app on sample/demo data)
DATABASE_URL="postgresql://user:password@localhost:5432/prophecy_radar"

# Platform APIs — the app works without these, using demo data instead
YOUTUBE_API_KEY=
TIKTOK_API_KEY=
FACEBOOK_API_KEY=

# AI provider (Anthropic) — powers relevance scoring, analysis, titles, thumbnails
AI_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-6

# Single-user MVP: id used for notes/status when multi-user auth isn't set up
DEFAULT_USER_ID=default-user

# Morning briefing email (optional — via Resend: https://resend.com)
RESEND_API_KEY=
BRIEFING_EMAIL_TO=
BRIEFING_EMAIL_FROM="Prophecy Radar <[email protected]>"
APP_URL=http://localhost:3000

# Protects /api/cron/* routes from being triggered by anyone but Vercel Cron
CRON_SECRET=
